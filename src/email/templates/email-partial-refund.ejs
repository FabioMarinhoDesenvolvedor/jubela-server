<%
  icon     = '↩';
  title    = 'Estorno parcial confirmado';
  subtitle = 'O reembolso dos itens foi processado';

  bodyContent = `
    <p>O estorno parcial do seu pedido foi processado. O valor referente aos itens devolvidos será creditado de acordo com as políticas da sua operadora ou banco.</p>

    <div class="amount-highlight">
      <div class="amount-label">Valor estornado</div>
      <div class="amount-value">R$ ${(refundAmount / 100).toFixed(2).replace('.', ',')}</div>
    </div>

    <div class="info-box">
      <div class="info-box-label">Itens estornados</div>
      ${details.map(item => `
        <div class="info-row">
          <span class="info-key">${item.productName} × ${item.quantity}</span>
          <span class="info-value">R$ ${(item.amount / 100).toFixed(2).replace('.', ',')}</span>
        </div>
      `).join('')}
    </div>

    <div class="info-box">
      <div class="info-box-label">Detalhes</div>

      <div class="info-row">
        <span class="info-key">Nº do pedido</span>
        <span class="info-value">#${order.id}</span>
      </div>

      <div class="info-row">
        <span class="info-key">Prazo estimado</span>
        <span class="info-value">Até 10 dias úteis</span>
      </div>

      <div class="info-row">
        <span class="info-key">Status</span>
        <span class="info-value">
          <span class="status-badge status-refunded">Estorno parcial</span>
        </span>
      </div>
    </div>

    <div class="cta-wrapper">
      <a href="${storeUrl}/orders/${order.id}" class="cta-button-outline">Ver pedido</a>
    </div>
  `;
%>
<%- include('email-base') %>
