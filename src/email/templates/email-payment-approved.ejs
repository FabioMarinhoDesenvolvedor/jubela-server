<%
  icon     = '✓';
  title    = 'Pagamento confirmado';
  subtitle = 'Seu pedido foi aprovado com sucesso';

  bodyContent = `
    <p>Seu pagamento foi confirmado e seu pedido já está sendo preparado.</p>

    <div class="amount-highlight">
      <div class="amount-label">Valor pago</div>
      <div class="amount-value">R$ ${(order.paidAmount / 100).toFixed(2).replace('.', ',')}</div>
    </div>

    <div class="info-box">
      <div class="info-box-label">Detalhes do pedido</div>

      <div class="info-row">
        <span class="info-key">Nº do pedido</span>
        <span class="info-value">#${order.id}</span>
      </div>

      <div class="info-row">
        <span class="info-key">Forma de pagamento</span>
        <span class="info-value">${order.captureMethod === 'credit_card' ? 'Cartão de crédito' : 'PIX'}</span>
      </div>

      <div class="info-row">
        <span class="info-key">Data</span>
        <span class="info-value">${new Date(order.paidAt).toLocaleDateString('pt-BR')}</span>
      </div>

      <div class="info-row">
        <span class="info-key">Status</span>
        <span class="info-value">
          <span class="status-badge status-approved">Aprovado</span>
        </span>
      </div>
    </div>

    <div class="divider"></div>

    <div class="info-box-label" style="margin-bottom:12px">Itens do pedido</div>
    <div class="items-list">
      ${order.items.map(item => `
        <div class="item-row">
          <span class="item-name">
            ${item.product_name}
            <span class="item-qty">× ${item.quantity}</span>
          </span>
          <span class="item-price">
            R$ ${((item.price * item.quantity) / 100).toFixed(2).replace('.', ',')}
          </span>
        </div>
      `).join('')}
    </div>

    <div class="cta-wrapper">
      <a href="${storeUrl}/orders/${order.id}" class="cta-button">Ver meu pedido</a>
    </div>
  `;
%>
<%- include('email-base') %>
