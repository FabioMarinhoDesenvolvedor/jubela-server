<!DOCTYPE html>
<html lang="pt-BR" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="color-scheme" content="light" />
  <meta name="supported-color-schemes" content="light" />
  <title><%= subject %></title>
  <!--[if mso]>
  <noscript>
    <xml>
      <o:OfficeDocumentSettings>
        <o:PixelsPerInch>96</o:PixelsPerInch>
      </o:OfficeDocumentSettings>
    </xml>
  </noscript>
  <![endif]-->
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300&family=DM+Sans:wght@300;400;500&display=swap');

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body, table, td, a {
      -webkit-text-size-adjust: 100%;
      -ms-text-size-adjust: 100%;
    }

    table, td {
      mso-table-lspace: 0pt;
      mso-table-rspace: 0pt;
    }

    img {
      -ms-interpolation-mode: bicubic;
      border: 0;
      outline: none;
      text-decoration: none;
    }

    body {
      font-family: 'DM Sans', 'Helvetica Neue', Helvetica, Arial, sans-serif;
      background-color: #f2f0ee;
      margin: 0;
      padding: 0;
      width: 100% !important;
      min-width: 100%;
    }

    .email-wrapper {
      background-color: #f2f0ee;
      padding: 48px 16px;
    }

    .email-container {
      max-width: 580px;
      margin: 0 auto;
      background-color: #ffffff;
      border-radius: 4px;
      overflow: hidden;
      box-shadow: 0 2px 24px rgba(77,70,68,0.10);
    }

    /* ── HEADER ── */
    .email-header {
      background: linear-gradient(160deg, #4d4644 0%, #6b6361 45%, #9f9997 100%);
      padding: 48px 48px 40px;
      text-align: center;
      position: relative;
    }

    .email-header::after {
      content: '';
      display: block;
      position: absolute;
      bottom: 0; left: 0; right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.18), transparent);
    }

    .store-name {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 13px;
      font-weight: 300;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.55);
      margin-bottom: 20px;
    }

    .header-icon {
      width: 52px;
      height: 52px;
      margin: 0 auto 20px;
      border-radius: 50%;
      background: rgba(255,255,255,0.12);
      border: 1px solid rgba(255,255,255,0.22);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      line-height: 52px;
      text-align: center;
    }

    .email-header h1 {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 28px;
      font-weight: 400;
      color: #ffffff;
      letter-spacing: 0.01em;
      line-height: 1.25;
      margin: 0;
    }

    .header-subtitle {
      font-family: 'DM Sans', sans-serif;
      font-size: 13px;
      font-weight: 300;
      color: rgba(255,255,255,0.62);
      margin-top: 10px;
      letter-spacing: 0.02em;
    }

    /* ── BODY ── */
    .email-body {
      padding: 44px 48px;
    }

    .greeting {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 18px;
      font-weight: 400;
      color: #4d4644;
      margin-bottom: 16px;
      font-style: italic;
    }

    .email-body p {
      font-size: 14.5px;
      line-height: 1.75;
      color: #5c5452;
      margin-bottom: 16px;
      font-weight: 300;
    }

    /* ── INFO BOX ── */
    .info-box {
      background: linear-gradient(135deg, #f7f5f4 0%, #efecea 100%);
      border-left: 3px solid #9f9997;
      border-radius: 0 3px 3px 0;
      padding: 20px 24px;
      margin: 28px 0;
    }

    .info-box-label {
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: #9f9997;
      margin-bottom: 12px;
    }

    .info-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      padding: 7px 0;
      border-bottom: 1px solid rgba(159,153,151,0.18);
    }

    .info-row:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }

    .info-key {
      font-size: 12px;
      color: #9f9997;
      font-weight: 400;
      letter-spacing: 0.03em;
    }

    .info-value {
      font-size: 13px;
      color: #4d4644;
      font-weight: 500;
      text-align: right;
    }

    /* ── HIGHLIGHT VALUE ── */
    .amount-highlight {
      text-align: center;
      padding: 24px;
      margin: 28px 0;
      background: linear-gradient(135deg, #4d4644 0%, #9f9997 100%);
      border-radius: 3px;
    }

    .amount-label {
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.55);
      margin-bottom: 8px;
    }

    .amount-value {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 36px;
      font-weight: 300;
      color: #ffffff;
      letter-spacing: 0.02em;
    }

    /* ── STATUS BADGE ── */
    .status-badge {
      display: inline-block;
      padding: 5px 14px;
      border-radius: 2px;
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .status-pending  { background: #f5f0e8; color: #a07c3a; }
    .status-approved { background: #e8f2ec; color: #2d7a4f; }
    .status-canceled { background: #f5eae8; color: #a03a3a; }
    .status-refunded { background: #eaecf5; color: #3a4aa0; }
    .status-reminder { background: #f0eaf5; color: #7a3aa0; }

    /* ── DIVIDER ── */
    .divider {
      height: 1px;
      background: linear-gradient(90deg, transparent, #e0dcda, transparent);
      margin: 28px 0;
    }

    /* ── CTA BUTTON ── */
    .cta-wrapper {
      text-align: center;
      margin: 32px 0 8px;
    }

    .cta-button {
      display: inline-block;
      padding: 14px 36px;
      background: linear-gradient(135deg, #4d4644 0%, #6b6361 100%);
      color: #ffffff !important;
      text-decoration: none;
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      border-radius: 2px;
    }

    .cta-button-outline {
      display: inline-block;
      padding: 13px 36px;
      background: transparent;
      color: #4d4644 !important;
      text-decoration: none;
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      border-radius: 2px;
      border: 1px solid #9f9997;
      margin-top: 12px;
    }

    /* ── ITEMS LIST ── */
    .items-list {
      margin: 20px 0;
    }

    .item-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 11px 0;
      border-bottom: 1px solid #f0ecea;
    }

    .item-row:last-child { border-bottom: none; }

    .item-name {
      font-size: 13.5px;
      color: #4d4644;
      font-weight: 400;
    }

    .item-qty {
      font-size: 12px;
      color: #9f9997;
      margin-left: 6px;
    }

    .item-price {
      font-size: 13.5px;
      color: #4d4644;
      font-weight: 500;
      white-space: nowrap;
    }

    /* ── ALERT STRIP ── */
    .alert-strip {
      border-radius: 2px;
      padding: 14px 20px;
      margin: 24px 0;
      font-size: 13px;
      line-height: 1.6;
      font-weight: 300;
    }

    .alert-warning {
      background: linear-gradient(135deg, #fdf6e8, #faeedd);
      border-left: 3px solid #c9963a;
      color: #7a5a1e;
    }

    .alert-info {
      background: linear-gradient(135deg, #edf4fb, #e4eef8);
      border-left: 3px solid #5a89b8;
      color: #2a4d70;
    }

    /* ── FOOTER ── */
    .email-footer {
      background: linear-gradient(180deg, #f7f5f4 0%, #efecea 100%);
      padding: 28px 48px 32px;
      text-align: center;
      border-top: 1px solid #e8e4e2;
    }

    .footer-logo {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 15px;
      font-weight: 400;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: #9f9997;
      margin-bottom: 16px;
    }

    .footer-links {
      margin-bottom: 16px;
    }

    .footer-links a {
      font-size: 11px;
      color: #9f9997;
      text-decoration: none;
      letter-spacing: 0.1em;
      margin: 0 10px;
    }

    .footer-copy {
      font-size: 11px;
      color: #c0bab8;
      line-height: 1.6;
      font-weight: 300;
    }

    .footer-copy a {
      color: #9f9997;
      text-decoration: underline;
    }

    /* ── RESPONSIVE ── */
    @media only screen and (max-width: 600px) {
      .email-header  { padding: 36px 28px 32px; }
      .email-body    { padding: 32px 28px; }
      .email-footer  { padding: 24px 28px 28px; }
      .email-header h1 { font-size: 23px; }
      .amount-value  { font-size: 30px; }
      .info-row      { display: block; }
      .info-value    { text-align: left; margin-top: 2px; }
    }
  </style>
</head>

<body>
<div class="email-wrapper">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
<tr>
  <td align="center">
  <div class="email-container">

    <!-- ══ HEADER ══ -->
    <div class="email-header">
      <div class="store-name"><%= storeName %></div>

      <div class="header-icon"><%= icon %></div>

      <h1><%= title %></h1>

      <% if (typeof subtitle !== 'undefined' && subtitle) { %>
        <div class="header-subtitle"><%= subtitle %></div>
      <% } %>
    </div>

    <!-- ══ BODY ══ -->
    <div class="email-body">

      <div class="greeting">Olá, <%= customerName %></div>

      <%- bodyContent %>

    </div>

    <!-- ══ FOOTER ══ -->
    <div class="email-footer">
      <div class="footer-logo"><%= storeName %></div>

      <div class="footer-links">
        <a href="<%= storeUrl %>">Loja</a>
        <a href="<%= storeUrl %>/orders">Meus pedidos</a>
        <a href="<%= storeUrl %>/support">Suporte</a>
      </div>

      <div class="footer-copy">
        Você está recebendo este e-mail pois realizou uma compra em
        <a href="<%= storeUrl %>"><%= storeName %></a>.<br />
        &copy; <%= new Date().getFullYear() %> <%= storeName %>. Todos os direitos reservados.
      </div>
    </div>

  </div>
  </td>
</tr>
</table>
</div>
</body>
</html>
